rules_version = '2';
// Lidex Firestore'ga faqat server (firebase-admin, service account) orqali murojaat qiladi.
// Admin SDK qoidalarni chetlab o'tadi, shuning uchun brauzer/mobil mijozlar uchun hamma narsa yopiq.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
