# ============ Lidex sozlamalari ============
# Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.

NODE_ENV=development
PORT=4000
# Tashqi HTTPS manzil. Mini App faqat HTTPS bilan ishlaydi (lokalda: ngrok / cloudflared tunnel manzili)
PUBLIC_URL=http://localhost:4000
# Kamida 32 ta tasodifiy belgi:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Birinchi ishga tushishda yaratiladigan superadmin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345

# ---------- Ma'lumotlar bazasi ----------
# memory    — lokal JSON fayl (server/data/dev-db.json), sinov uchun
# firestore — Firebase Firestore (production)
DB_DRIVER=memory
# FIREBASE_PROJECT_ID=my-project-id
# Service account JSON: (a) fayl yo'li, yoki (b) JSON matni / base64 ko'rinishida
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT=
# FIRESTORE_DATABASE_ID=          # "(default)" dan boshqa nomli baza bo'lsa
# FIRESTORE_PREFIX=               # bitta loyihada staging/prod ajratish uchun, masalan "staging_"

# ---------- Telegram bot (@BotFather) ----------
BOT_TOKEN=
# polling — lokal/VPS uchun oddiy;  webhook — HTTPS domen bilan production uchun
BOT_MODE=polling
# WEBHOOK_SECRET=random-string

# ---------- Userbot (ixtiyoriy) ----------
# Lidlar guruhga BOSHQA BOT orqali tushsa kerak bo'ladi (botlar bir-birini ko'rmaydi).
# https://my.telegram.org dan api_id/api_hash oling, keyin:  npm run userbot:login
USERBOT_ENABLED=false
# TG_API_ID=
# TG_API_HASH=
# TG_USERBOT_SESSION=

# ---------- Vaqt va eslatmalar ----------
TZ_OFFSET_MINUTES=300
QUIET_HOURS_START=21
QUIET_HOURS_END=8
REMINDER_HOUR=9
SCHEDULER_INTERVAL_SEC=60

# Faqat lokal sinov: Mini App'ni Telegramsiz ochish (/app?dev_tg=111). Production'da YOQMANG!
DEV_AUTH=false
LOG_LEVEL=info
